# Copy to server/.env  —  NOT the repository root.
#
# npm runs workspace scripts with the working directory set to server/, so
# `npm run dev` and `npm run seed` load server/.env. A .env at the repo root
# is silently ignored.

# ---- Database (libSQL / Turso) ----
# Local development: a plain SQLite file, resolved relative to server/.
# This is also the default if DATABASE_URL is unset entirely.
DATABASE_URL=file:./data/my-day-buddy.db
#
# Deployed: point at Turso and supply its token. Setting a file: URL while
# NODE_ENV=production is rejected at startup — serverless filesystems are
# read-only and per-instance, so the database has to be remote.
#   DATABASE_URL=libsql://<database>-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<turso db tokens create <database>>
DATABASE_AUTH_TOKEN=

# ---- Server ----
# REQUIRED in production; the server refuses to start without it.
#   openssl rand -base64 48
JWT_SECRET=
PORT=4000
# Only needed when the client is served from a different origin (local dev).
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
