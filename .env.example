# ---- Database (libSQL / Turso) ----
# Local development: a plain SQLite file. This is the default if unset.
DATABASE_URL=file:./server/data/my-day-buddy.db
# Deployed: point at Turso and supply its token.
#   DATABASE_URL=libsql://<database>-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<token from `turso db tokens create <database>`>
DATABASE_AUTH_TOKEN=

# ---- Server ----
# REQUIRED in production. Generate with: openssl rand -base64 48
JWT_SECRET=
PORT=4000
# Only needed when the client is served from a different origin (local dev).
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
