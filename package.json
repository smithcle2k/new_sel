{
  "name": "my-day-buddy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "My Day Buddy \u2014 a touch-first daily SEL check-in for ages 3-5, with a state-compliance reporting engine for teachers.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "seed": "npm run seed --workspace server",
    "start": "npm run start --workspace server",
    "migrate": "npm run migrate --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
